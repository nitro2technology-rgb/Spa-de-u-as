# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA pongas valores reales en este archivo (.env.example SÍ se versiona).

# ── Meta / WhatsApp Cloud API ────────────────────────────────────────
# Se obtienen en Meta for Developers > tu App > WhatsApp > API Setup

# Token de acceso. En producción debe ser el token PERMANENTE de un
# System User (Business Settings > Users > System Users), no el temporal
# de 24h que muestra la pantalla de API Setup.
WHATSAPP_TOKEN=

# ID del número de teléfono desde el que envía el bot (no es el número,
# es un ID numérico largo que da Meta)
PHONE_NUMBER_ID=

# ID de la WhatsApp Business Account (WABA) dueña de ese número.
# Necesario para suscribir la WABA a la App (ver scripts/meta_setup.py).
WABA_ID=

# ID de la App de Meta y su App Secret (Configuración > Básica).
# APP_SECRET se usa para validar la firma de los webhooks entrantes:
# sin esto, cualquiera que conozca tu URL pública puede inyectar mensajes falsos.
APP_ID=
APP_SECRET=

# Palabra que tú inventas; debe coincidir con la que pongas en Meta
# al configurar el webhook.
VERIFY_TOKEN=

# Número de WhatsApp del dueño/asesor que recibe las notificaciones.
# Formato internacional sin "+", ej: 573001234567
OWNER_PHONE_NUMBER=

# ── Botón de WhatsApp para la web ────────────────────────────────────
# Número VISIBLE del negocio, formato internacional sin "+".
# No es lo mismo que PHONE_NUMBER_ID (ese es un ID interno de Meta).
BUSINESS_WHATSAPP_NUMBER=

# ── Avisos al dueño fuera de la ventana de 24h ───────────────────────
# Nombre e idioma de la plantilla aprobada en Meta que se usa para
# avisarte de un lead cuando llevas más de 24h sin escribirle al bot.
# Si se deja vacío, esos avisos no llegan (queda avisado en los logs).
# Verifica su estado con: python scripts/meta_setup.py plantillas
OWNER_TEMPLATE_NAME=
OWNER_TEMPLATE_LANG=es

# ── Toma de control manual ───────────────────────────────────────────
# Clave para los endpoints /admin/takeover, /admin/release y /admin/contacts.
# Si se deja vacía, esos endpoints quedan deshabilitados.
# Genera una larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# También sirve para entrar al panel del PRIMER cliente (el dueño del bot)
# mientras ese cliente no tenga usuarios propios. En cuanto se le crea uno
# con `python scripts/panel_usuario.py crear 1 tu@correo.com`, esta clave
# deja de abrir el panel y se queda solo con los endpoints de arriba.
# Los demás clientes NUNCA entran con ella: cada negocio tiene los suyos.
ADMIN_API_KEY=

# Minutos que la conversación puede quedarse quieta —sin mensajes del
# cliente NI respuestas tuyas— antes de que el bot la retome por su
# cuenta. Mientras cualquiera de los dos escriba, no interrumpe.
# Opcional, por defecto 180 (3 horas).
# HUMAN_TAKEOVER_TIMEOUT_MINUTES=180

# ── Super-admin (la consola de la plataforma) ────────────────────────
# Clave de /superadmin: dar de alta negocios, pausar a quien no paga y ver
# el consumo de IA de cada cliente. Es TUYA, no de ningún cliente.
# Mientras esté vacía, /superadmin responde 503 y no existe.
# Genérala larga: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERADMIN_KEY=

# ── Sesión del panel web ─────────────────────────────────────────────
# Con qué se firma la cookie de sesión. Antes la firmaba ADMIN_API_KEY, o
# sea la contraseña del panel; ahora es un secreto del servidor y ningún
# cliente lo conoce. Opcional: si se deja vacía se deriva de SECRETS_KEY.
# Genera una larga: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Cambiarla cierra todas las sesiones abiertas, de todos los clientes.
# SESSION_SECRET=

# Horas de inactividad tras las cuales el panel vuelve a pedir la clave.
# Es deslizante: mientras trabajes se renueva sola. Opcional, 5 por defecto.
# PANEL_SESION_INACTIVIDAD_HORAS=5

# Tope absoluto de una sesión, se use o no. Opcional, 12 por defecto.
# PANEL_SESION_MAXIMA_HORAS=12

# Intentos de clave fallidos antes de bloquear esa IP, y minutos que dura
# el bloqueo. Opcionales, 8 y 15 por defecto.
# PANEL_MAX_INTENTOS_LOGIN=8
# PANEL_BLOQUEO_LOGIN_MINUTOS=15

# ── App instalable en el celular (PWA) ───────────────────────────────
# El panel se instala desde el navegador ("Añadir a pantalla de inicio")
# y queda con icono propio, sin barra de direcciones. Funciona sin tocar
# nada de esto; son solo para ponerle la cara del negocio.

# Lo que se lee en el aviso de instalación. Opcional.
# APP_NOMBRE=Mi Negocio · Conversaciones

# Lo que cabe debajo del icono. iOS y Android recortan a ~12 caracteres.
# Opcional, por defecto el nombre del negocio.
# APP_NOMBRE_CORTO=Mi Negocio

# Color de marca: pinta la barra de estado del celular y el fondo del
# icono. Opcional, por defecto el verde del panel.
# MARCA_COLOR=#16a34a

# Fondo de la pantalla de arranque, ese instante antes de que cargue el
# panel. Opcional.
# MARCA_COLOR_FONDO=#f6f7f9

# ── Google (Calendar + Sheets) ───────────────────────────────────────
# Ruta al archivo .json de la cuenta de servicio (en local), o el
# contenido completo del JSON en una sola línea (en el hosting).
GOOGLE_SERVICE_ACCOUNT_JSON=google-credentials.json

# ID del calendario del negocio (Calendar > Configuración > Integrar calendario)
GOOGLE_CALENDAR_ID=

# ID del Sheet: el tramo de la URL entre "/d/" y "/edit"
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Horario de atención ──────────────────────────────────────────────
BUSINESS_TIMEZONE=America/Bogota
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
APPOINTMENT_DURATION_MINUTES=60

# ── Base de datos ────────────────────────────────────────────────────
# ESTA LÍNEA ES LA QUE DEJA CORRER EL BOT EN TU MÁQUINA. Déjala como
# está: guarda la base en un archivo bot.db dentro del proyecto.
#
# Hace falta porque el valor por defecto del código apunta al disco del
# servidor (/var/data/bot.db), que en producción es lo correcto pero en
# un portátil no existe: sin esta línea el bot no arranca en local.
#
# No afecta a producción. Este archivo no se versiona ni entra al
# contenedor (.gitignore y .dockerignore), y en Render las variables se
# definen en su panel.
DATABASE_URL=sqlite:///./bot.db

# En producción es PostgreSQL, y no por volumen sino por aislamiento entre
# clientes: SQLite no soporta Row-Level Security. En Render la inyecta el
# blueprint (ver render.yaml), aquí solo hace falta si quieres probar en
# local contra Postgres:
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Clave maestra con la que se cifran las credenciales de cada cliente
# guardadas en la tabla `clients`: su token de WhatsApp, su JSON de Google
# y su clave de Gemini. Ver app/core/secretos.py.
#
# Se genera UNA vez:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Sin ella el bot funciona igual —sigue leyendo las credenciales del
# entorno— pero no se pueden dar de alta clientes nuevos, porque sus
# secretos no se pueden guardar cifrados.
#
# ⚠️ Si se pierde, lo cifrado no se recupera: hay que volver a pedirle sus
# credenciales a cada cliente. Guárdala fuera del hosting también.
SECRETS_KEY=

# Días de conversación que se guardan. Al arrancar el servicio se borra
# lo más viejo: sin esto la tabla de mensajes crece para siempre, y el
# disco es lo que se paga en el hosting.
#
# Los leads y las citas NO se tocan: viven en otra tabla y en el Sheet.
# En 0 no borra nada. Opcional, 180 por defecto.
# HISTORIAL_DIAS=180

# ── Imágenes y notas de voz del chat ─────────────────────────────────
# El disco solo guarda una copia TEMPORAL. Meta conserva 7 días todo lo
# que entra por el webhook, así que si abres una conversación de hace
# tres días el archivo se vuelve a bajar solo y no notas nada.
#
# Por eso un día basta: con 5 MB por imagen harían falta unas 200
# imágenes vistas el mismo día para llenar el disco de 1 GB.
# En 0 no borra nada por antigüedad. Opcional, 1 por defecto.
# MEDIA_CACHE_DIAS=1

# Tope duro de la carpeta. Si se pasa, se borra lo más viejo aunque no
# haya cumplido el plazo: quedarse sin disco no solo perdería imágenes,
# dejaría a la base sin dónde escribir. Opcional, 200 por defecto.
# MEDIA_CACHE_MB=200

# Dónde se guarda ese caché. Por defecto va junto al archivo de la base,
# que es el único sitio que sobrevive al despliegue. Casi nunca se toca.
# MEDIA_DIR=/var/data/media

# ── Plan Pro: el bot con IA (Gemini) ─────────────────────────────────
# De CADA negocio decide su ficha en /superadmin (`ia_contratada`,
# `ia_activa`). Estas dos variables solo las lee la configuración base: el
# bot de casa mientras no tenga contenido propio, los scripts y el
# servidor local. Ponerlas en Render NO le regala la IA a nadie.
# IA_CONTRATADA=false
IA_ACTIVA=false

# La clave de la PLATAFORMA: la ponemos nosotros y la usan todos los
# negocios que no traigan la suya (esa se pega en su ficha). El consumo de
# cada uno se mide aparte y se ve en /superadmin.
#
# Se saca en https://aistudio.google.com/apikey y se comprueba con:
#     python scripts/gemini_setup.py
GEMINI_API_KEY=

# Opcionales. Solo se tocan si hace falta.
#
# El modelo. Está en una variable para poder cambiarlo sin desplegar el
# día que salga uno mejor o más barato — o el día que Google retire el
# que estabas usando, que también pasa: "gemini-2.5-flash" (el valor
# anterior) se retira el 16 de octubre de 2026.
# GEMINI_MODELO=gemini-3.1-flash-lite

# Segundos que se espera a la IA antes de rendirse y responder con el
# menú. Corto a propósito: Meta reintenta el webhook si tardamos, y ese
# reintento le llega al cliente como un mensaje repetido.
# IA_TIMEOUT_SEGUNDOS=8

# Mensajes al día por contacto que pueden llegar a la IA. Frena a quien
# escriba en bucle antes de que le vacíe la cuota al negocio. Pasado el
# tope el bot sigue respondiendo con el menú. En 0 no hay tope.
# IA_MAX_MENSAJES_DIA=40

# ── Correo de avisos (de la plataforma, no de cada negocio) ─────────
# Con qué cuenta se le avisa por correo a las áreas de cada negocio cuando
# entra un lead. Es la vía que siempre llega: WhatsApp tiene tres puertas
# que bloquean un aviso en silencio (ver app/core/correo.py). Sin
# SMTP_HOST y SMTP_DESDE no se manda ningún correo, y un aviso de un área
# que solo tiene correo cae al número del dueño.
# Gmail: smtp.gmail.com, puerto 587 y una CONTRASEÑA DE APLICACIÓN.
# SMTP_HOST=
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_DESDE=
# SMTP_NOMBRE=Nitro 2Tech

# La dirección del panel, para el enlace "Abrir en el panel" del correo.
# PANEL_URL=https://bot.nitro2tech.com

# ── Subdominios por negocio (opcional) ───────────────────────────────
# Con esto, panaderia.tudominio.com es el panel de "panaderia". Sin esto,
# todos entran por la misma dirección y el negocio sale de la sesión.
# DOMINIO_BASE=
